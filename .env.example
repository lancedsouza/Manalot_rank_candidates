# Copy to .env and fill in:  cp .env.example .env
# Never commit .env (it is gitignored). Use placeholder values only in this file.

# --- Required ---------------------------------------------------------------

# Postgres with the pgvector extension. Use a local container for development;
# Neon (sslmode=require) only for production.
#   local: docker run -d -p 5431:5432 -e POSTGRES_PASSWORD=pw pgvector/pgvector:pg16
DATABASE_URL=postgresql://postgres:pw@localhost:5431/postgres
# DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require

# Groq LLM, used for JD and resume extraction (app/services/gemini_service.py).
GROQ_API_KEY=your-groq-api-key

# Redis: caches, Celery broker and result backend.
# worker.py refuses to start without it; the other modules default to
# redis://localhost:6380 (app/utils/redis_config.py).
#   local: docker run -d -p 6380:6379 redis:alpine
#   inside docker-compose use the service host instead of localhost.
REDIS_URL=redis://localhost:6380/0

# --- Optional ---------------------------------------------------------------

# Override the Groq API base URL (default https://api.groq.com).
# GROQ_BASE_URL=

# Only for the standalone scripts app/utils/model_avail.py and
# app/services/check_model.py; the app itself does not use Gemini.
# GEMINI_API_KEY=
